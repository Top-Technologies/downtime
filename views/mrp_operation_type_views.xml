<odoo>
    <record id="view_mrp_operation_type_tree" model="ir.ui.view">
        <field name="name">mrp.operation.type.tree</field>
        <field name="model">mrp.operation.type</field>
        <field name="arch" type="xml">
            <list string="Operation Types">
                <field name="name"/>
                <field name="code"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_mrp_operation_type_form" model="ir.ui.view">
        <field name="name">mrp.operation.type.form</field>
        <field name="model">mrp.operation.type</field>
        <field name="arch" type="xml">
            <form string="Operation Type">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_mrp_operation_types" model="ir.actions.act_window">
        <field name="name">Operation Types</field>
        <field name="res_model">mrp.operation.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first operation type!
            </p>
            <p>
                Operation types are used to categorize different types of manufacturing operations.
            </p>
        </field>
    </record>
</odoo>
